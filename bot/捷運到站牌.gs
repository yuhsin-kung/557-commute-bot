function mrtDistanceM_(a, b) {
  const r = 6371000, rad = x => x * Math.PI / 180;
  const dLat = rad(b[0] - a[0]), dLng = rad(b[1] - a[1]);
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a[0])) * Math.cos(rad(b[0])) * Math.sin(dLng / 2) ** 2;
  return 2 * r * Math.asin(Math.sqrt(h));
}

/** 離這個位置最近的捷運站（直線距離）。士林站本身也算：那就直接走去 557 站牌 */
function mrtNearest_(here) {
  let best = { code: 'R16', name: '士林', at: SHILIN_MRT, toShilin: 0, m: mrtDistanceM_(here, SHILIN_MRT) };
  MRT_STATIONS.forEach(s => {
    const m = mrtDistanceM_(here, [s[2], s[3]]);
    if (m < best.m) best = { code: s[0], name: s[1], at: [s[2], s[3]], toShilin: s[4], m };
  });
  return best;
}

/** 走路幾分鐘：先問 Google 地圖（走路模式），查不到就用距離估。回傳 { min, source } */
function mrtMapsAllowed_() {
  const cache = CacheService.getScriptCache();
  const now = new Date();
  const keys = ['mrtMaps:m:' + Utilities.formatDate(now, TZ, 'yyyyMMddHHmm'), 'mrtMaps:d:' + Utilities.formatDate(now, TZ, 'yyyyMMdd')];
  const used = keys.map(k => Number(cache.get(k) || 0));
  if (used[0] >= MRT_MAPS_PER_MIN || used[1] >= MRT_MAPS_PER_DAY) return false;
  cache.put(keys[0], String(used[0] + 1), 120);
  cache.put(keys[1], String(used[1] + 1), 21600);
  return true;
}

function mrtWalk_(from, to) {
  if (mrtMapsAllowed_()) try {
    const res = Maps.newDirectionFinder().setOrigin(from[0], from[1]).setDestination(to[0], to[1])
      .setMode(Maps.DirectionFinder.Mode.WALKING).getDirections();
    const sec = res && res.routes && res.routes[0] && res.routes[0].legs[0].duration.value;
    if (typeof sec === 'number' && sec >= 0) return { min: Math.ceil(sec / 60), source: 'Google 地圖' };
  } catch (e) {
    console.log('Google 地圖查不到走路時間：' + e);
  }
  return { min: Math.ceil(mrtDistanceM_(from, to) * WALK_DETOUR / WALK_M_PER_MIN), source: '用距離估' };
}

function mrtMinuteOfDay_(date) {
  return Number(Utilities.formatDate(date, TZ, 'H')) * 60 + Number(Utilities.formatDate(date, TZ, 'mm')) + date.getSeconds() / 60;
}

function mrtAtMinute_(date, minute) {
  const midnight = new Date(Utilities.formatDate(date, TZ, 'yyyy-MM-dd') + 'T00:00:00+08:00');
  return new Date(midnight.getTime() + minute * 60000);
}

/**
 * 在 code 這一站、ready 這一刻走到月台，搭得上的第一班幾點到士林站。
 * 北邊（芝山～淡水、新北投）搭往南的車，其他（市區、別條線轉乘）搭往北的車。
 * 列車到士林的時刻＝士林站時刻表；在這一站上車＝士林時刻 − 旅程時間。回傳 Date，沒有車（或假日）回 null
 */
function mrtTrainToShilin_(code, toShilin, ready) {
  const wd = Number(Utilities.formatDate(ready, TZ, 'u'));
  if (wd >= 6) return null;
  const north = /^R(1[7-9]|2\d)/.test(code);
  const transfer = !/(^|\/)R\d/.test(code);
  const need = mrtMinuteOfDay_(ready) + toShilin + (transfer ? MRT_TRANSFER_WAIT_MIN : 0);
  const t = SHILIN_TT[north ? 'S' : 'N'].find(m => m >= need);
  return t === undefined ? null : mrtAtMinute_(ready, t);
}

/**
 * 主流程：從這個位置出發，幾點到 557 站牌。網頁用 google.script.run 呼叫（名稱不能底線結尾）。
 * 回傳 { ok, station, walkMin, walkSource, trainAtShilin, atStop, lines }，時間是 'HH:mm'
 */
function mrtPlanFromHere(lat, lng, nowMs) {
  const here = [Number(lat), Number(lng)];
  if (!isFinite(here[0]) || !isFinite(here[1]) || Math.abs(here[0]) > 90 || Math.abs(here[1]) > 180) return { ok: false, lines: ['定位格式不對'] };
  const now = nowMs ? new Date(nowMs) : new Date();
  const hm = d => Utilities.formatDate(d, TZ, 'HH:mm');
  const st = mrtNearest_(here);
  if (st.code === 'R16') {
    const w = mrtWalk_(here, SHILIN_MRT);
    const atStop = new Date(now.getTime() + w.min * 60000);
    return { ok: true, station: '士林', walkMin: w.min, walkSource: w.source, trainAtShilin: null, atStop: hm(atStop),
      school: mrtSchool_(atStop),
      lines: [`你就在士林站附近，走到 557 站牌約 ${w.min} 分鐘（${w.source}）`, `約 ${hm(atStop)} 到站牌`].concat(p557Lines_(atStop)) }; // 到校預估.gs
  }
  const w = mrtWalk_(here, st.at);
  const ready = new Date(now.getTime() + (w.min + MRT_ENTER_MIN) * 60000);
  const train = mrtTrainToShilin_(st.code, st.toShilin, ready);
  if (!train) return { ok: false, station: st.name, walkMin: w.min, walkSource: w.source,
    lines: [`最近的捷運站是${st.name}站，走路約 ${w.min} 分鐘`, '這個時間查不到捷運班次（目前只有平常日 06:00–18:59 的時刻表）'] };
  const atStop = new Date(train.getTime() + MRT_EXIT_TO_STOP_MIN * 60000);
  return { ok: true, station: st.name, walkMin: w.min, walkSource: w.source, trainAtShilin: hm(train), atStop: hm(atStop),
    school: mrtSchool_(atStop),
    lines: [`走到${st.name}站約 ${w.min} 分鐘（${w.source}）`, `搭捷運，${hm(train)} 到士林站`, `出站走到 557 站牌約 ${MRT_EXIT_TO_STOP_MIN} 分鐘，約 ${hm(atStop)} 到站牌`]
      .concat(p557Lines_(atStop)) }; // 到校預估.gs
}

/** 推薦的站牌和幾點到東吳（給網頁顯示）：{ stop, early, late }，時間是 'HH:mm'，離峰 late＝null */
function mrtSchool_(atStop) {
  const r = p557Both_(atStop); // 到校預估.gs
  if (!r) return null;
  const hm = d => (d ? Utilities.formatDate(d, TZ, 'HH:mm') : null);
  return { stop: r.best.stop, early: hm(r.best.early), late: hm(r.best.late), peak: r.best.peak };
}
